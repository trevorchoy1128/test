<script>
/* ══════════ 1. 目錄結構 ══════════ */
const NAV=[
 ["入門",[["home","開始"],["howto","怎樣溫書"]]],
 ["A · 基本經濟概念",[["A1","稀缺與選擇"],["A2","機會成本"],["A3","產權與專業化"],["A4","循環流量．實證規範"]]],
 ["B · 廠商與生產",[["B1","所有權與資金"],["B2","生產．物品．分工"],["B3","生產要素"],["B4","短期生產與成本"],["B5","規模．整合．目標"]]],
 ["C · 市場與價格",[["C1","需求"],["C2","供給"],["C3","市場均衡"],["C4","剩餘與價格功能"],["C5","價格彈性"],["C6","上限．下限．配額"],["C7","單位稅與補貼"]]],
 ["D · 競爭與市場結構",[["D1","市場與四種結構"],["D2","壟斷力量與判別"]]],
 ["E · 效率、公平與政府",[["E1","效率與五種干預"],["E2","私人 vs 社會成本"],["E3","公平與收入不平等"]]],
 ["F · 經濟表現的量度",[["F1","GDP 與三種算法"],["F2","實質．人均．GNP"],["F3","物價與失業"]]],
 ["G · 國民收入決定",[["G1","總需求 AD"],["G2","總供給 AS"],["G3","均衡與調整"]]],
 ["H · 貨幣與銀行",[["H1","貨幣與銀行"],["H2","貨幣供應．信用創造"],["H3","貨幣需求．金融中心"]]],
 ["I · 宏觀問題與政策",[["I1","周期與通脹"],["I2","失業與缺口"],["I3","財政政策"],["I4","貨幣政策"]]],
 ["J · 國際貿易與金融",[["J1","比較優勢與得益"],["J2","貿易障礙"],["J3","國際收支"],["J4","匯率與聯繫匯率"]]],
 ["選修一 · 壟斷與競爭政策",[["EL1a","壟斷定價"],["EL1b","價格歧視"],["EL1c","反競爭行為"]]],
 ["選修二 · 貿易與增長",[["EL2a","貿易理論延伸"],["EL2b","增長與發展"]]],
 ["工具",[["frameworks","答題框架"],["traps","範圍與陷阱"],["lab","互動圖表室"],["quiz","MC 測驗中心"]]]
];
const ORDER=[],LABEL={};
NAV.forEach(g=>g[1].forEach(it=>{ORDER.push(it[0]);LABEL[it[0]]=it[1];}));
const READABLE=ORDER.filter(id=>!["home","lab","quiz"].includes(id));

/* ══════════ 2. 進度儲存 ══════════ */
const LS="dse-econ-progress";
let done={}, dbRef=null;
try{ done=JSON.parse(localStorage.getItem(LS)||"{}"); }catch(e){ done={}; }
function saveProgress(){
  try{ localStorage.setItem(LS,JSON.stringify(done)); }catch(e){}
  if(dbRef){ dbRef.doc("progress/main").set({done:done,at:Date.now()}).catch(()=>{}); }
}
(async()=>{
  try{
    const db = window.claude && claude.use ? await claude.use("db") : null;
    if(!db) return;
    dbRef = db;
    const snap = await db.doc("progress/main").get();
    if(snap.exists){
      const d = snap.data()||{};
      if(d.done && typeof d.done==="object"){ done=Object.assign({},d.done,done); saveProgress(); paintProgress(); }
    }else{ saveProgress(); }
  }catch(e){}
})();

/* ══════════ 3. 側欄與路由 ══════════ */
const nav=document.getElementById("nav"), pagesEl=document.getElementById("pages");
NAV.forEach(g=>{
  const h=document.createElement("div"); h.className="navgroup"; h.textContent=g[0]; nav.appendChild(h);
  g[1].forEach(it=>{
    const b=document.createElement("button");
    b.className="navlink"; b.dataset.id=it[0];
    b.innerHTML='<em>'+(/^(home|howto|frameworks|traps|lab|quiz)$/.test(it[0])?"·":it[0].replace(/^EL/,"E"))+'</em><span>'+it[1]+'</span><span class="tick">✓</span>';
    b.onclick=()=>go(it[0]);
    nav.appendChild(b);
  });
});
function paintProgress(){
  let n=0;
  document.querySelectorAll(".navlink").forEach(b=>{
    const on=!!done[b.dataset.id]; b.classList.toggle("done",on);
  });
  READABLE.forEach(id=>{ if(done[id]) n++; });
  document.getElementById("pbar").style.width=(n/READABLE.length*100).toFixed(1)+"%";
  document.getElementById("ptxt").textContent="已讀 "+n+" / "+READABLE.length+" 節";
  document.querySelectorAll("[data-donebtn]").forEach(b=>{
    const id=b.dataset.donebtn;
    b.textContent=done[id]?"✓ 已讀（按此取消）":"標記為已讀";
    b.classList.toggle("ghost",!!done[id]);
  });
}
function go(id,noHash){
  const el=document.getElementById("pg-"+id);
  if(!el) return;
  document.querySelectorAll(".pg").forEach(p=>p.classList.toggle("on",p===el));
  document.querySelectorAll(".navlink").forEach(b=>b.classList.toggle("on",b.dataset.id===id));
  const grp=NAV.find(g=>g[1].some(i=>i[0]===id));
  document.getElementById("crumb").textContent=(grp?grp[0]+" › ":"")+LABEL[id];
  if(!noHash) location.hash=id;
  window.scrollTo(0,0);
  closeSide();
  el.querySelectorAll(".quiz[data-quiz]").forEach(mountQuiz);
  el.querySelectorAll(".lab[data-lab]").forEach(mountLab);
}
/* 自動加上「標記為已讀」與上一節／下一節 */
ORDER.forEach((id,i)=>{
  const el=document.getElementById("pg-"+id); if(!el) return;
  if(id!=="home"){
    if(READABLE.includes(id)){
      const row=document.createElement("div"); row.className="done-row";
      row.innerHTML='<p>讀完了？標記一下，左邊的進度條會記住（換裝置都在）。</p>';
      const b=document.createElement("button"); b.className="btn"; b.dataset.donebtn=id;
      b.onclick=()=>{ done[id]=!done[id]; if(!done[id]) delete done[id]; saveProgress(); paintProgress(); };
      row.appendChild(b); el.appendChild(row);
    }
    const pn=document.createElement("div"); pn.className="pagenav";
    const prev=ORDER[i-1], next=ORDER[i+1];
    if(prev){ const b=document.createElement("button"); b.innerHTML='<small>← 上一節</small>'+LABEL[prev]; b.onclick=()=>go(prev); pn.appendChild(b); } else pn.appendChild(document.createElement("span"));
    if(next){ const b=document.createElement("button"); b.style.textAlign="right"; b.innerHTML='<small>下一節 →</small>'+LABEL[next]; b.onclick=()=>go(next); pn.appendChild(b); }
    el.appendChild(pn);
  }
});
document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>go(b.dataset.go));

/* ══════════ 4. 主題／側欄 ══════════ */
const root=document.documentElement, tb=document.getElementById("themebtn");
function curTheme(){ return root.getAttribute("data-theme") || (matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light"); }
function setTheme(t){ root.setAttribute("data-theme",t); tb.textContent=t==="dark"?"淺色":"深色"; try{localStorage.setItem("dse-econ-theme",t)}catch(e){} }
try{ const t=localStorage.getItem("dse-econ-theme"); if(t) setTheme(t); else tb.textContent=curTheme()==="dark"?"淺色":"深色"; }catch(e){}
tb.onclick=()=>setTheme(curTheme()==="dark"?"light":"dark");
document.getElementById("resetbtn").onclick=()=>{ if(confirm("確定要清除所有已讀記錄？")){ done={}; saveProgress(); paintProgress(); } };
const side=document.getElementById("side"), scrim=document.getElementById("scrim");
function closeSide(){ side.classList.remove("open"); scrim.classList.remove("on"); }
document.getElementById("burger").onclick=()=>{ side.classList.add("open"); scrim.classList.add("on"); };
scrim.onclick=closeSide;

/* ══════════ 5. MC 測驗 ══════════ */
function mountQuiz(box){
  if(box.dataset.built) return; box.dataset.built="1";
  const key=box.dataset.quiz, bank=(window.QBANK||{})[key];
  if(!bank||!bank.length){ box.innerHTML='<div class="wip"><b>這一節的練習題正在編寫中。</b>你可以先去「MC 測驗中心」做其他範圍的題目。</div>'; return; }
  const head=document.createElement("h2");
  head.innerHTML='<span class="kp">練習</span>做幾題，測試你是否真的明白';
  box.parentNode.insertBefore(head,box);
  renderQuiz(box,bank,key);
}
function renderQuiz(box,bank,key){
  box.innerHTML="";
  const bar=document.createElement("div"); bar.className="quizbar";
  const scoreEl=document.createElement("b"); scoreEl.textContent="0";
  bar.appendChild(document.createTextNode("已答 "));
  const ansEl=document.createElement("b"); ansEl.textContent="0"; bar.appendChild(ansEl);
  bar.appendChild(document.createTextNode(" / "+bank.length+" 題　答對 "));
  bar.appendChild(scoreEl);
  bar.appendChild(document.createTextNode(" 題"));
  const again=document.createElement("button"); again.className="btn ghost"; again.style.marginLeft="auto"; again.textContent="重做";
  again.onclick=()=>renderQuiz(box,bank,key);
  bar.appendChild(again);
  box.appendChild(bar);
  let answered=0,correct=0;
  bank.forEach((q,i)=>{
    const card=document.createElement("div"); card.className="q";
