}
function tableLab(box,cfg){
  box.innerHTML='<div class="lab-hd"><span>計算器</span><b>'+cfg.title+'</b></div><div style="padding:14px 18px"><div class="tw"></div><div class="lab-say" style="border:0;padding:12px 0 0"></div></div>';
  const tw=box.querySelector(".tw"), say=box.querySelector(".lab-say");
  let vals=cfg.init.slice();
  function draw(){
    const rows=cfg.compute(vals);
    let h='<table class="compact"><thead><tr>'+cfg.cols.map(c=>'<th class="num">'+c+'</th>').join("")+'</tr></thead><tbody>';
    rows.forEach((r,i)=>{ h+='<tr>'+r.map((c,j)=>j===cfg.editCol?'<td class="num"><input type="number" data-i="'+i+'" value="'+c+'" style="width:74px;font:inherit;font-family:var(--f-mono);text-align:right;background:var(--surface);color:var(--ink);border:1px solid var(--rule);border-radius:5px;padding:3px 6px"></td>':'<td class="num">'+c+'</td>').join("")+'</tr>'; });
    h+='</tbody></table>';
    tw.innerHTML=h;
    tw.querySelectorAll("input").forEach(inp=>inp.oninput=()=>{ vals[+inp.dataset.i]=+inp.value||0; const p=document.activeElement.dataset.i; draw(); const n=tw.querySelector('input[data-i="'+p+'"]'); if(n){n.focus();n.setSelectionRange(n.value.length,n.value.length);} });
    say.innerHTML=cfg.say(vals);
  }
  draw();
}
function makeElas(box){
  const st={P1:10,Q1:40,P2:8,Q2:60};
  box.innerHTML='<div class="lab-hd"><span>計算器</span><b>弧彈性（平均價格與平均數量法）</b></div>'+
    '<div class="lab-bd"><div class="lab-cv" style="flex-direction:column;align-items:stretch;gap:10px;padding:18px"></div><div class="lab-ct"></div></div><div class="lab-say"></div>';
  const cv=box.querySelector(".lab-cv"), read=document.createElement("div"); read.className="read";
  box.querySelector(".lab-ct").appendChild(read);
  const say=box.querySelector(".lab-say");
  [["P1","原價格 P₁"],["Q1","原數量 Q₁"],["P2","新價格 P₂"],["Q2","新數量 Q₂"]].forEach(k=>{
    const w=document.createElement("div"); w.style.display="flex"; w.style.justifyContent="space-between"; w.style.alignItems="center"; w.style.gap="10px";
    w.innerHTML='<span style="font-family:var(--f-mono);font-size:.8rem;color:var(--ink-soft)">'+k[1]+'</span>';
    const inp=document.createElement("input"); inp.type="number"; inp.value=st[k[0]];
    inp.style.cssText="width:110px;font:inherit;font-family:var(--f-mono);text-align:right;background:var(--surface);color:var(--ink);border:1px solid var(--rule);border-radius:6px;padding:6px 9px";
    inp.oninput=()=>{ st[k[0]]=+inp.value||0; draw(); };
    w.appendChild(inp); cv.appendChild(w);
  });
  function draw(){
    const dQ=st.Q2-st.Q1, dP=st.P2-st.P1, aQ=(st.Q1+st.Q2)/2, aP=(st.P1+st.P2)/2;
    const e = (dP===0||aQ===0||aP===0) ? NaN : Math.abs((dQ/aQ)/(dP/aP));
    const TR1=st.P1*st.Q1, TR2=st.P2*st.Q2;
    let cls = isNaN(e)?"—" : e>1.001?"富彈性 elastic" : e<0.999?"乏彈性 inelastic" : "單位彈性 unit elastic";
    read.innerHTML='<div><span>ΔQ ÷ 平均 Q</span><b>'+(aQ?f1(dQ/aQ*100)+"%":"—")+'</b></div>'+
      '<div><span>ΔP ÷ 平均 P</span><b>'+(aP?f1(dP/aP*100)+"%":"—")+'</b></div>'+
      '<div class="hl"><span>|PED|</span><b>'+(isNaN(e)?"—":f1(e))+'</b></div>'+
      '<div class="hl"><span>分類</span><b>'+cls+'</b></div>'+
      '<div><span>原總收入 TR₁</span><b>$'+f0(TR1)+'</b></div>'+
      '<div><span>新總收入 TR₂</span><b>$'+f0(TR2)+'</b></div>'+
      '<div><span>TR 變化</span><b>'+(TR2>TR1?"上升":TR2<TR1?"下跌":"不變")+' $'+f0(Math.abs(TR2-TR1))+'</b></div>';
    say.innerHTML= isNaN(e) ? "<b>請輸入不同的兩個價格。</b>" :
      '<b>解讀：</b>|PED| = '+f1(e)+'，屬'+cls+'。'+(dP<0?"減價":"加價")+'令總收入'+(TR2>TR1?"上升":TR2<TR1?"下跌":"不變")+' —— '+
      (e>1?"因為數量變動的百分比大於價格變動的百分比，數量效應主導。":e<1?"因為數量變動的百分比小於價格變動的百分比，價格效應主導。":"兩個效應剛好抵消。")+
      ' 考試答題時記得寫出公式、代入數字、附單位，並<strong>解讀答案</strong>（只寫一個數字通常會失分）。';
  }
  draw();
}
function makeOC(box){
  const opts=[["做兼職",500],["陪家人食飯",300],["在家睇戲",150]];
  let pick=0;
  box.innerHTML='<div class="lab-hd"><span>計算器</span><b>機會成本計算器</b></div>'+
    '<div style="padding:16px 18px"><div class="opts" id="oclist" style="max-width:520px"></div>'+
    '<div class="lab-say" style="border:0;padding:14px 0 0"></div></div>';
  const list=box.querySelector("#oclist"), say=box.querySelector(".lab-say");
  function draw(){
    list.innerHTML="";
    opts.forEach((o,i)=>{
      const b=document.createElement("button"); b.className="opt"+(i===pick?" ok":"");
      b.innerHTML='<em>'+(i===pick?"✓":"·")+'</em><span style="flex:1">'+o[0]+'</span>';
      const inp=document.createElement("input"); inp.type="number"; inp.value=o[1];
      inp.style.cssText="width:96px;font:inherit;font-family:var(--f-mono);text-align:right;background:var(--surface);color:var(--ink);border:1px solid var(--rule);border-radius:5px;padding:3px 7px";
      inp.onclick=e=>e.stopPropagation();
      inp.oninput=()=>{ opts[i][1]=+inp.value||0; draw(); };
      b.appendChild(inp);
      b.onclick=()=>{ pick=i; draw(); };
      list.appendChild(b);
    });
    const others=opts.filter((_,i)=>i!==pick);
    const best=others.reduce((a,b)=>b[1]>a[1]?b:a,others[0]);
    const sum=others.reduce((a,b)=>a+b[1],0);
    say.innerHTML='<b>你揀了「'+opts[pick][0]+'」。機會成本 = $'+f0(best[1])+'（'+best[0]+'）。</b><br>'+
      '不是 $'+f0(sum)+' —— 因為如果你不揀「'+opts[pick][0]+'」，你也只能揀其餘選項中的<strong>一個</strong>，而你當然會揀價值最高的「'+best[0]+'」。其餘的在任何情況下都會被放棄，不是因為這個選擇才失去。<br>'+
      '<span style="color:var(--ink-faint)">試下改動數值：如果出現一個價值更高的新選項，機會成本就會上升。</span>';
  }
  draw();
}
function mountLab(box){
  if(box.dataset.built) return; box.dataset.built="1";
  const k=box.dataset.lab;
  if(k==="sd") makeSD(box,{modes:["eq"],title:"供求均衡：拖動滑桿看曲線移位",tag:"互動"});
  else if(k==="surplus") makeSD(box,{modes:["eq"],title:"消費者剩餘與生產者剩餘",tag:"互動"});
  else if(k==="sd2") makeSD(box,{modes:["ceiling","floor"],title:"價格上限與價格下限",tag:"互動"});
  else if(k==="quota") makeSD(box,{modes:["quota"],title:"配額：屈折供給曲線",tag:"互動"});
  else if(k==="tax") makeSD(box,{modes:["tax","subsidy"],title:"單位稅與單位補貼：稅負分擔",tag:"互動"});
  else if(k==="sdfull") makeSD(box,{modes:["eq","ceiling","floor","quota","tax","subsidy"],title:"供求與市場干預：全部模式",tag:"主實驗室",elastic:true});
  else if(k==="shift") makeShift(box);
  else if(k==="elas") makeElas(box);
  else if(k==="oc") makeOC(box);
  else if(k==="prod") tableLab(box,{title:"總產量 → 平均產量、邊際產量",
    cols:["工人數 L","總產量 TP（可改）","平均產量 AP","邊際產量 MP"],editCol:1,init:[10,24,33,38,38,35],
    compute:v=>v.map((tp,i)=>[i+1,tp,f1(tp/(i+1)),(i===0?tp:tp-v[i-1])]),
    say:v=>{ let mx=0,mi=0; v.forEach((t,i)=>{if(t>mx){mx=t;mi=i;}});
      const mp=v.map((t,i)=>i===0?t:t-v[i-1]); let pmi=0; mp.forEach((m,i)=>{if(m>mp[pmi])pmi=i;});
      return '<b>觀察：</b>總產量在第 '+(mi+1)+' 名工人時最高（'+mx+'）；邊際產量在第 '+(pmi+1)+' 名工人時最高（'+mp[pmi]+'）。留意 <strong>TP 最大時 MP 接近或等於 0</strong>，不是 MP 最大。改動 TP 欄的數字，看三條數怎樣連動。<br><span style="color:var(--ink-faint)">MP 是逐行相減（每次加一名工人時）；AP 是 TP ÷ 工人數。切勿用 AP 相減當 MP。</span>'; }});
  else if(k==="cost") tableLab(box,{title:"總成本 → 平均成本、邊際成本",
    cols:["產量 Q","總成本 TC（可改）","平均成本 AC","邊際成本 MC"],editCol:1,init:[20,45,62,76,95,125],
    compute:v=>v.map((tc,i)=>[i,tc,(i===0?"—":f1(tc/i)),(i===0?"— (FC)":tc-v[i-1])]),
    say:v=>'<b>觀察：</b>第一行 Q = 0 的總成本就是<strong>固定成本 FC = $'+v[0]+'</strong>。試下只改 FC（第一行）而其他行同步加同一個數 —— 你會發現 <strong>MC 完全不變</strong>，但 AC 全部上升。這正是考試常出的送分題：<strong>固定成本改變不影響邊際成本</strong>。<br><span style="color:var(--ink-faint)">由 MC 還原 TC：TC = FC + 之前所有 MC 的累加。</span>'});
}

/* ══════════ 7. 啟動 ══════════ */
paintProgress();
const start=(location.hash||"").replace("#","");
go(ORDER.includes(start)?start:"home",true);
window.addEventListener("hashchange",()=>{ const h=location.hash.replace("#",""); if(ORDER.includes(h)) go(h,true); });
