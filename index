    <text x="560" y="270" font-size="11.5" fill="var(--demand)" font-weight="700">AD</text>
    <line x1="70" y1="170" x2="390" y2="170" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>
    <line x1="390" y1="170" x2="390" y2="285" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>
    <circle cx="390" cy="170" r="5" fill="var(--accent-ink)"/>
    <text x="398" y="166" font-size="11.5" fill="var(--accent-ink)" font-weight="700">E</text>
    <text x="38" y="174" font-size="10.5" fill="var(--ink-soft)">P*</text>
    <text x="370" y="304" font-size="10.5" fill="var(--ink-soft)">Y* ＝ Y<tspan font-size="8">f</tspan></text>
    <rect x="92" y="60" width="212" height="46" rx="6" fill="var(--surface-2)" stroke="var(--rule)" stroke-width="1"/>
    <text x="102" y="78" font-size="10" fill="var(--ink)">長期均衡：三條線交於一點</text>
    <text x="102" y="94" font-size="10" fill="var(--ink-soft)">AD ＝ SRAS ＝ LRAS，Y* ＝ Y<tspan font-size="8">f</tspan></text>
