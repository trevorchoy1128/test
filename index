/* ══════════ 6. 互動圖表引擎 ══════════ */
const X0=56,Y0=268,XW=344,YH=244,QMAX=110,PMAX=140;
const X=q=>X0+q*(XW/QMAX), Y=p=>Y0-p*(YH/PMAX);
const f1=n=>(Math.round(n*10)/10).toLocaleString("en-US",{maximumFractionDigits:1});
const f0=n=>Math.round(n).toLocaleString("en-US");

function sdCalc(s){
  const {Da,Db,Sa,Sb}=s;
  const Qe=(Da-Sa)/(Db+Sb), Pe=Sa+Sb*Qe;
  const D=q=>Da-Db*q, S=q=>Sa+Sb*q;
  const areaD=q=>Da*q-Db*q*q/2, areaS=q=>Sa*q+Sb*q*q/2;
  let Qt=Qe,Pb=Pe,Ps=Pe,gov=0,eff=true,note="",extra="";
  if(s.mode==="ceiling"){ if(s.pc<Pe){ Qt=(s.pc-Sa)/Sb; Pb=Ps=s.pc; const Qd=(Da-s.pc)/Db; extra="短缺 "+f1(Qd-Qt)+" 單位"; } else { eff=false; note="上限高於均衡價，無效"; } }
  if(s.mode==="floor"){ if(s.pf>Pe){ Qt=(Da-s.pf)/Db; Pb=Ps=s.pf; const Qs=(s.pf-Sa)/Sb; extra="過剩 "+f1(Qs-Qt)+" 單位"; } else { eff=false; note="下限低於均衡價，無效"; } }
  if(s.mode==="quota"){ if(s.qq<Qe){ Qt=s.qq; Pb=Ps=D(Qt); extra="無短缺亦無過剩"; } else { eff=false; note="配額多於均衡量，無效"; } }
  if(s.mode==="tax"){ Qt=Math.max(0,(Da-Sa-s.t)/(Db+Sb)); Pb=D(Qt); Ps=Pb-s.t; gov=s.t*Qt; extra="消費者承擔 $"+f1(Pb-Pe)+"／單位，生產者承擔 $"+f1(Pe-Ps)+"／單位"; }
  if(s.mode==="subsidy"){ Qt=(Da-Sa+s.s)/(Db+Sb); Pb=D(Qt); Ps=Pb+s.s; gov=-s.s*Qt; extra="政府支出 $"+f0(s.s*Qt); }
  if(Qt<0) Qt=0;
  const CS=areaD(Qt)-Pb*Qt, PS=Ps*Qt-areaS(Qt);
  const TSmax=areaD(Qe)-areaS(Qe), TS=CS+PS+gov, DWL=TSmax-TS;
  return {Qe,Pe,Qt,Pb,Ps,CS,PS,gov,DWL,TS,eff,note,extra,D,S};
}
function sdSvg(s,c){
  const {Da,Db,Sa,Sb}=s, D=c.D, S=c.S;
  const qD=Math.min(QMAX,Da/Db), qS=QMAX;
  const clip=(q,p)=>{ if(p>PMAX){ return null; } return X(q)+","+Y(p); };
  let g="";
  g+='<line x1="'+X0+'" y1="'+Y0+'" x2="'+(X0+XW)+'" y2="'+Y0+'" stroke="var(--ink)" stroke-width="1.3"/>';
  g+='<line x1="'+X0+'" y1="'+Y0+'" x2="'+X0+'" y2="20" stroke="var(--ink)" stroke-width="1.3"/>';
  g+='<text x="'+(X0+XW)+'" y="'+(Y0+20)+'" text-anchor="end" font-size="10.5" fill="var(--ink-soft)">Quantity</text>';
  g+='<text x="'+(X0-6)+'" y="18" text-anchor="start" font-size="10.5" fill="var(--ink-soft)">Price ($)</text>';
  /* shading */
  const poly=(pts,fill,op)=>'<polygon points="'+pts.map(p=>X(p[0])+","+Y(p[1])).join(" ")+'" fill="'+fill+'" opacity="'+(op||1)+'"/>';
  if(c.Qt>0.3){
    g+=poly([[0,c.Pb],[0,Math.min(Da,PMAX)],[c.Qt,D(c.Qt)],[c.Qt,c.Pb]],"var(--demand-soft)");
    g+=poly([[0,c.Ps],[0,Sa],[c.Qt,S(c.Qt)],[c.Qt,c.Ps]],"var(--supply-soft)");
    if(Math.abs(c.gov)>0.5) g+=poly([[0,c.Ps],[0,c.Pb],[c.Qt,c.Pb],[c.Qt,c.Ps]],"var(--accent-soft)",.95);
    if(Math.abs(c.DWL)>0.5) g+=poly([[c.Qt,D(c.Qt)],[c.Qe,c.Pe],[c.Qt,S(c.Qt)]],"var(--flag)",.3);
  }
  /* curves */
  const dEnd=Da/Db<=QMAX?[Da/Db,0]:[QMAX,D(QMAX)];
  const dStart=Da<=PMAX?[0,Da]:[(Da-PMAX)/Db,PMAX];
  g+='<line x1="'+X(dStart[0])+'" y1="'+Y(dStart[1])+'" x2="'+X(dEnd[0])+'" y2="'+Y(dEnd[1])+'" stroke="var(--demand)" stroke-width="2"/>';
  const sEndP=Math.min(PMAX,S(QMAX)), sEndQ=(sEndP-Sa)/Sb;
  g+='<line x1="'+X(0)+'" y1="'+Y(Sa)+'" x2="'+X(sEndQ)+'" y2="'+Y(sEndP)+'" stroke="var(--supply)" stroke-width="2"/>';
  g+='<text x="'+(X(dEnd[0])-4)+'" y="'+(Y(dEnd[1])-6)+'" text-anchor="end" font-size="11" fill="var(--demand)" font-weight="600">D</text>';
  g+='<text x="'+(X(sEndQ)+4)+'" y="'+(Y(sEndP)+4)+'" font-size="11" fill="var(--supply)" font-weight="600">S</text>';
  if(s.mode==="tax"||s.mode==="subsidy"){
    const sh=s.mode==="tax"?s.t:-s.s, a=Sa+sh;
    const eP=Math.min(PMAX,a+Sb*QMAX), eQ=(eP-a)/Sb, stQ=a<0?(-a)/Sb:0, stP=Math.max(0,a);
    g+='<line x1="'+X(stQ)+'" y1="'+Y(stP)+'" x2="'+X(eQ)+'" y2="'+Y(eP)+'" stroke="var(--supply)" stroke-width="2" stroke-dasharray="5 3"/>';
    g+='<text x="'+(X(eQ)+4)+'" y="'+(Y(eP)+14)+'" font-size="10" fill="var(--supply)">'+(s.mode==="tax"?"S+稅":"S−補貼")+'</text>';
  }
  if(s.mode==="quota"&&c.eff) g+='<line x1="'+X(c.Qt)+'" y1="'+Y0+'" x2="'+X(c.Qt)+'" y2="'+Y(PMAX)+'" stroke="var(--flag)" stroke-width="2" stroke-dasharray="4 3"/>';
  if((s.mode==="ceiling"||s.mode==="floor")&&c.eff){
    g+='<line x1="'+X0+'" y1="'+Y(c.Pb)+'" x2="'+(X0+XW)+'" y2="'+Y(c.Pb)+'" stroke="var(--flag)" stroke-width="1.8" stroke-dasharray="5 3"/>';
    g+='<text x="'+(X0+XW-2)+'" y="'+(Y(c.Pb)-5)+'" text-anchor="end" font-size="10" fill="var(--flag)">'+(s.mode==="ceiling"?"價格上限":"價格下限")+'</text>';
  }
  /* equilibrium marks */
  g+='<circle cx="'+X(c.Qe)+'" cy="'+Y(c.Pe)+'" r="3.4" fill="var(--ink)"/>';
  g+='<text x="'+(X(c.Qe)+7)+'" y="'+(Y(c.Pe)-6)+'" font-size="10" fill="var(--ink-soft)">E₀</text>';
  if(c.Qt>0.3&&(Math.abs(c.Qt-c.Qe)>0.3)){
    g+='<line x1="'+X(c.Qt)+'" y1="'+Y0+'" x2="'+X(c.Qt)+'" y2="'+Y(Math.max(c.Pb,c.Ps))+'" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>';
    g+='<circle cx="'+X(c.Qt)+'" cy="'+Y(c.Pb)+'" r="3.2" fill="var(--demand)"/>';
    if(Math.abs(c.Pb-c.Ps)>0.5) g+='<circle cx="'+X(c.Qt)+'" cy="'+Y(c.Ps)+'" r="3.2" fill="var(--supply)"/>';
    g+='<text x="'+X(c.Qt)+'" y="'+(Y0+14)+'" text-anchor="middle" font-size="9.5" fill="var(--ink-soft)">Q₁</text>';
  }
  g+='<line x1="'+X(c.Qe)+'" y1="'+Y0+'" x2="'+X(c.Qe)+'" y2="'+Y(c.Pe)+'" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>';
  g+='<line x1="'+X0+'" y1="'+Y(c.Pe)+'" x2="'+X(c.Qe)+'" y2="'+Y(c.Pe)+'" stroke="var(--ink-faint)" stroke-width="1" stroke-dasharray="3 3"/>';
  g+='<text x="'+X(c.Qe)+'" y="'+(Y0+26)+'" text-anchor="middle" font-size="9.5" fill="var(--ink-faint)">Q*</text>';
  g+='<text x="'+(X0-7)+'" y="'+(Y(c.Pe)+4)+'" text-anchor="end" font-size="9.5" fill="var(--ink-faint)">P*</text>';
  return '<svg viewBox="0 0 420 300" role="img" aria-label="供求圖">'+g+'</svg>';
}
