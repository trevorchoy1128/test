<title>DSE 經濟科自學課本</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700;900&family=Noto+Sans+TC:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<style>
/* ─── tokens ─────────────────────────────────────────────── */
:root{
  --paper:#F1F4F6; --surface:#FFFFFF; --surface-2:#E9EEF1;
  --ink:#141A20; --ink-soft:#576470; --ink-faint:#8B96A0;
  --rule:#D8DFE4; --rule-soft:#E6EBEF;
  --accent:#09665B; --accent-soft:#DDEDEA; --accent-ink:#064C44;
  --demand:#2A5CA8; --demand-soft:#DEE7F5;
  --supply:#BC5029; --supply-soft:#F6E4DB;
  --flag:#AB2317; --flag-soft:#F7E3E0;
  --gold:#7E6118; --gold-soft:#F2EBD7;
  --shadow:0 1px 2px rgba(20,26,32,.05), 0 8px 20px -14px rgba(20,26,32,.22);
  --f-display:"Noto Serif TC","Songti TC",Georgia,serif;
  --f-body:"Instrument Sans","Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;
  --f-mono:"IBM Plex Mono","SFMono-Regular",Consolas,monospace;
  --sidebar:284px;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0E1317; --surface:#161D23; --surface-2:#1D262D;
    --ink:#E3E9ED; --ink-soft:#9DAAB4; --ink-faint:#6D7B85;
    --rule:#28333B; --rule-soft:#1F2A31;
    --accent:#43C0AF; --accent-soft:#12332F; --accent-ink:#6FD6C7;
    --demand:#83AAE9; --demand-soft:#16243A; --supply:#E88E63; --supply-soft:#33211A;
    --flag:#F0857A; --flag-soft:#361D1B; --gold:#D5B45F; --gold-soft:#2C2617;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 24px -16px rgba(0,0,0,.7);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#0E1317; --surface:#161D23; --surface-2:#1D262D;
  --ink:#E3E9ED; --ink-soft:#9DAAB4; --ink-faint:#6D7B85;
  --rule:#28333B; --rule-soft:#1F2A31;
  --accent:#43C0AF; --accent-soft:#12332F; --accent-ink:#6FD6C7;
  --demand:#83AAE9; --demand-soft:#16243A; --supply:#E88E63; --supply-soft:#33211A;
  --flag:#F0857A; --flag-soft:#361D1B; --gold:#D5B45F; --gold-soft:#2C2617;
  --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 24px -16px rgba(0,0,0,.7);
  color-scheme:dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--f-body);
  font-size:16px;line-height:1.72;-webkit-font-smoothing:antialiased;}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* ─── shell ──────────────────────────────────────────────── */
.shell{display:flex;min-height:100vh}
.side{width:var(--sidebar);flex:0 0 var(--sidebar);background:var(--surface);
  border-right:1px solid var(--rule);position:sticky;top:0;height:100vh;
  overflow-y:auto;overscroll-behavior:contain;display:flex;flex-direction:column}
.brand{padding:22px 20px 16px;border-bottom:1px solid var(--rule-soft);display:flex;
  flex-direction:column;gap:3px}
.brand b{font-family:var(--f-display);font-weight:900;font-size:1.16rem;letter-spacing:.01em;line-height:1.3}
.brand span{font-family:var(--f-mono);font-size:.66rem;letter-spacing:.13em;
  text-transform:uppercase;color:var(--ink-faint)}
.progbar{height:4px;background:var(--surface-2);border-radius:99px;overflow:hidden;margin-top:10px}
.progbar i{display:block;height:100%;background:var(--accent);width:0%;transition:width .35s ease}
.progtxt{font-family:var(--f-mono);font-size:.66rem;color:var(--ink-faint);margin-top:5px}
nav{padding:12px 10px 40px;flex:1}
.navgroup{font-family:var(--f-mono);font-size:.63rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink-faint);padding:16px 12px 7px}
.navlink{display:flex;gap:9px;align-items:baseline;width:100%;text-align:left;background:none;
  border:0;font:inherit;font-size:.895rem;color:var(--ink-soft);padding:7px 11px;border-radius:7px;
  cursor:pointer;line-height:1.42}
.navlink:hover{background:var(--surface-2);color:var(--ink)}
.navlink.on{background:var(--accent-soft);color:var(--accent-ink);font-weight:500}
.navlink em{font-family:var(--f-mono);font-style:normal;font-size:.7rem;color:var(--ink-faint);
  flex:0 0 15px;padding-top:2px}
.navlink.on em{color:var(--accent)}
.navlink.sub{padding-left:33px;font-size:.83rem}
.navlink .tick{margin-left:auto;font-family:var(--f-mono);font-size:.62rem;color:var(--accent);opacity:0}
.navlink.done .tick{opacity:1}
.sidefoot{padding:14px 20px 20px;border-top:1px solid var(--rule-soft);display:flex;gap:8px;align-items:center}
.mini{font:500 .72rem/1 var(--f-mono);letter-spacing:.06em;padding:7px 10px;border:1px solid var(--rule);
  background:var(--surface);color:var(--ink-soft);border-radius:6px;cursor:pointer}
.mini:hover{border-color:var(--accent);color:var(--accent)}

main{flex:1;min-width:0;padding:0 0 120px}
.wrap{max-width:820px;margin:0 auto;padding:0 34px}
.topbar{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--paper) 88%,transparent);
  backdrop-filter:blur(9px);border-bottom:1px solid var(--rule-soft);padding:11px 0;margin-bottom:0}
.topbar .wrap{display:flex;align-items:center;gap:12px}
.crumb{font-family:var(--f-mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--ink-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.burger{display:none}

/* ─── page head ──────────────────────────────────────────── */
.phead{padding:46px 0 26px;border-bottom:2px solid var(--ink);margin-bottom:34px}
.phead .ltr{font-family:var(--f-mono);font-size:.72rem;letter-spacing:.18em;color:var(--accent);
  text-transform:uppercase;margin-bottom:12px;display:block}
h1{font-family:var(--f-display);font-weight:900;font-size:clamp(1.85rem,4.3vw,2.65rem);
  line-height:1.2;margin:0 0 6px;text-wrap:balance;letter-spacing:-.01em}
.phead .en{font-family:var(--f-body);font-style:italic;font-size:1.02rem;color:var(--ink-soft);margin:0}
.phead .lede{margin:18px 0 0;font-size:1.03rem;color:var(--ink-soft);max-width:64ch}

h2{font-family:var(--f-display);font-weight:700;font-size:1.5rem;line-height:1.34;
  margin:56px 0 4px;text-wrap:balance;scroll-margin-top:70px;padding-top:4px}
h2 .kp{font-family:var(--f-mono);font-weight:500;font-size:.68rem;letter-spacing:.12em;
  color:var(--accent);display:block;margin-bottom:8px;text-transform:uppercase}
h2 + .h2en{font-family:var(--f-body);font-style:italic;color:var(--ink-soft);margin:0 0 20px;font-size:.95rem}
h3{font-family:var(--f-display);font-weight:700;font-size:1.13rem;margin:34px 0 10px;line-height:1.4}
h4{font-size:.95rem;margin:24px 0 6px;font-weight:600}
p{margin:0 0 16px;max-width:68ch}
main a{color:var(--accent-ink);text-decoration-thickness:1px;text-underline-offset:2px}
ul,ol{margin:0 0 16px;padding-left:22px;max-width:66ch}
li{margin-bottom:7px}
li::marker{color:var(--ink-faint)}
strong{font-weight:600}
.en{font-family:var(--f-body);font-style:italic}
code,.mono{font-family:var(--f-mono);font-size:.88em}
.term{font-family:var(--f-mono);font-size:.8em;font-style:normal;background:var(--surface-2);
  padding:1px 6px;border-radius:4px;color:var(--ink-soft);white-space:nowrap}

/* ─── block vocabulary ───────────────────────────────────── */
.blk{margin:22px 0}
.blk-lbl{font-family:var(--f-mono);font-size:.63rem;letter-spacing:.15em;text-transform:uppercase;
  display:block;margin-bottom:7px;font-weight:600}
/* 定義 */
.def{border-left:3px solid var(--accent);background:var(--surface);padding:16px 20px;
  border-radius:0 8px 8px 0;box-shadow:var(--shadow)}
.def .blk-lbl{color:var(--accent)}
.def b{font-family:var(--f-display);font-size:1.06rem;display:block;margin-bottom:2px}
.def .term-en{font-family:var(--f-mono);font-size:.78rem;color:var(--ink-soft);display:block;margin-bottom:9px}
.def p:last-child{margin-bottom:0}
/* 例子 */
.eg{background:var(--gold-soft);padding:15px 19px;border-radius:8px}
.eg .blk-lbl{color:var(--gold)}
.eg p:last-child,.eg ul:last-child,.eg li:last-child{margin-bottom:0}
.eg ul{padding-left:19px}
/* 陷阱 */
.trap{border-left:3px dashed var(--flag);background:var(--flag-soft);padding:15px 19px;border-radius:0 8px 8px 0}
.trap .blk-lbl{color:var(--flag)}
.trap p:last-child,.trap ul:last-child{margin-bottom:0}
/* 不用學 */
.skip{border:1px dashed var(--rule);border-radius:8px;padding:14px 18px;color:var(--ink-soft);font-size:.93rem}
.skip .blk-lbl{color:var(--ink-faint)}
.skip ul{padding-left:19px;margin-bottom:0}
.skip li{margin-bottom:4px}
/* 答題框架 */
.frame{background:var(--surface);border:1px solid var(--rule);border-radius:8px;padding:18px 20px}
.frame .blk-lbl{color:var(--demand)}
.frame ol{counter-reset:s;list-style:none;padding-left:0;margin-bottom:0;max-width:none}
.frame ol>li{counter-increment:s;position:relative;padding-left:34px;margin-bottom:11px}
.frame ol>li::before{content:counter(s);position:absolute;left:0;top:1px;font-family:var(--f-mono);
  font-size:.7rem;font-weight:600;width:22px;height:22px;border-radius:5px;background:var(--demand-soft);
  color:var(--demand);display:grid;place-items:center}
.frame ol>li:last-child{margin-bottom:0}
.kw{font-family:var(--f-mono);font-size:.8em;background:var(--demand-soft);color:var(--demand);
  padding:1px 6px;border-radius:4px;white-space:nowrap}
/* 提示 */
.note{background:var(--accent-soft);border-radius:8px;padding:14px 18px;font-size:.95rem}
.note .blk-lbl{color:var(--accent-ink)}
.note p:last-child{margin-bottom:0}

/* ─── tables ─────────────────────────────────────────────── */
.tw{overflow-x:auto;margin:22px 0;border:1px solid var(--rule);border-radius:8px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:.92rem;min-width:460px}
th,td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--rule-soft);vertical-align:top}
thead th{background:var(--surface-2);font-family:var(--f-mono);font-size:.68rem;letter-spacing:.09em;
  text-transform:uppercase;color:var(--ink-soft);font-weight:600;white-space:nowrap}
tbody tr:last-child td{border-bottom:0}
td.num,th.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums;text-align:right}
tbody th{font-weight:600;white-space:nowrap}
table.compact td,table.compact th{padding:7px 12px}

/* ─── interactive panel ──────────────────────────────────── */
.lab{margin:28px 0;background:var(--surface);border:1px solid var(--rule);border-radius:12px;
  overflow:hidden;box-shadow:var(--shadow)}
.lab-hd{padding:14px 20px;border-bottom:1px solid var(--rule-soft);display:flex;
  align-items:baseline;gap:10px;flex-wrap:wrap}
.lab-hd b{font-family:var(--f-display);font-size:1.02rem;margin-right:auto;min-width:0}
.lab-hd span{font-family:var(--f-mono);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--accent)}
.lab-bd{display:grid;grid-template-columns:minmax(0,1fr) 262px}
@media(max-width:820px){.lab-bd{grid-template-columns:1fr}}
.lab-cv{padding:14px;min-width:0;display:flex;align-items:center;justify-content:center}
.lab-cv svg{width:100%;height:auto;max-width:430px;display:block}
.lab-ct{border-left:1px solid var(--rule-soft);padding:16px 18px;background:var(--surface-2);
  display:flex;flex-direction:column;gap:14px}
@media(max-width:820px){.lab-ct{border-left:0;border-top:1px solid var(--rule-soft)}}
.modes{display:flex;flex-wrap:wrap;gap:5px}
.modes button{font:500 .73rem/1 var(--f-mono);padding:6px 9px;border:1px solid var(--rule);
  background:var(--surface);color:var(--ink-soft);border-radius:6px;cursor:pointer}
.modes button.on{background:var(--accent);border-color:var(--accent);color:#fff}
:root[data-theme="dark"] .modes button.on,
:root:not([data-theme="light"]) .modes button.on{color:#08201D}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]) .modes button.on{color:#fff}}
.sld label{display:flex;justify-content:space-between;font-family:var(--f-mono);font-size:.7rem;
  color:var(--ink-soft);margin-bottom:3px}
.sld label b{color:var(--ink);font-variant-numeric:tabular-nums}
.sld input[type=range]{width:100%;accent-color:var(--accent);margin:0 0 9px}
.read{font-family:var(--f-mono);font-size:.74rem;display:grid;gap:4px}
.read div{display:flex;justify-content:space-between;gap:8px}
.read span{color:var(--ink-soft)}
.read b{font-variant-numeric:tabular-nums}
.read .hl b{color:var(--accent-ink)}
.legend{display:flex;flex-wrap:wrap;gap:10px;font-family:var(--f-mono);font-size:.66rem;color:var(--ink-soft)}
.legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px}
.lab-say{padding:12px 20px 16px;border-top:1px solid var(--rule-soft);font-size:.9rem;color:var(--ink-soft)}
.lab-say b{color:var(--ink)}

/* ─── quiz ───────────────────────────────────────────────── */
.quiz{margin:30px 0;display:grid;gap:14px}
.q{background:var(--surface);border:1px solid var(--rule);border-radius:10px;padding:18px 20px;box-shadow:var(--shadow)}
.q-no{font-family:var(--f-mono);font-size:.64rem;letter-spacing:.13em;text-transform:uppercase;
  color:var(--ink-faint);display:flex;justify-content:space-between;margin-bottom:9px}
.q-stem{margin:0 0 14px;font-weight:500;max-width:none}
.q-stem .tw{margin:12px 0}
.opts{display:grid;gap:7px}
.opt{display:flex;gap:11px;align-items:flex-start;text-align:left;width:100%;background:var(--surface);
  border:1px solid var(--rule);border-radius:8px;padding:10px 13px;font:inherit;font-size:.94rem;
  color:var(--ink);cursor:pointer;line-height:1.55}
.opt:hover:not(.rev){border-color:var(--accent);background:var(--accent-soft)}
.opt em{font-family:var(--f-mono);font-style:normal;font-weight:600;font-size:.8rem;flex:0 0 auto;
  width:20px;height:20px;border-radius:5px;background:var(--surface-2);color:var(--ink-soft);
  display:grid;place-items:center;margin-top:2px}
.opt.rev{cursor:default}
.opt.ok{border-color:var(--accent);background:var(--accent-soft)}
.opt.ok em{background:var(--accent);color:var(--surface)}
.opt.no{border-color:var(--flag);background:var(--flag-soft)}
.opt.no em{background:var(--flag);color:var(--surface)}
.opt.dim{opacity:.62}
.why{font-size:.86rem;color:var(--ink-soft);margin-top:6px;display:block;line-height:1.6}
.opt.ok .why{color:var(--accent-ink)}
.q-exp{margin-top:13px;padding-top:13px;border-top:1px dashed var(--rule);font-size:.9rem;color:var(--ink-soft)}
.q-exp b{color:var(--ink);font-family:var(--f-mono);font-size:.68rem;letter-spacing:.12em;
  text-transform:uppercase;display:block;margin-bottom:5px;color:var(--accent)}
.q-exp[hidden]{display:none}
.quizbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 18px;background:var(--surface-2);
  border-radius:10px;font-family:var(--f-mono);font-size:.76rem;color:var(--ink-soft)}
.quizbar b{color:var(--ink);font-variant-numeric:tabular-nums}

/* ─── misc ───────────────────────────────────────────────── */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:12px;margin:24px 0}
.card{background:var(--surface);border:1px solid var(--rule);border-radius:10px;padding:16px 18px;
  text-align:left;font:inherit;cursor:pointer;color:var(--ink);display:flex;flex-direction:column;gap:5px}
.card:hover{border-color:var(--accent)}
.card em{font-family:var(--f-mono);font-style:normal;font-size:.65rem;letter-spacing:.13em;
  text-transform:uppercase;color:var(--accent)}
.card b{font-family:var(--f-display);font-size:1.02rem;line-height:1.35}
.card span{font-size:.85rem;color:var(--ink-soft);line-height:1.55}
.done-row{display:flex;align-items:center;gap:12px;margin:44px 0 0;padding:16px 20px;
  border:1px solid var(--rule);border-radius:10px;background:var(--surface);flex-wrap:wrap}
.done-row p{margin:0;font-size:.9rem;color:var(--ink-soft);flex:1;min-width:180px}
.btn{font:600 .82rem/1 var(--f-body);padding:10px 16px;border-radius:7px;border:1px solid var(--accent);
  background:var(--accent);color:#fff;cursor:pointer}
:root[data-theme="dark"] .btn,:root:not([data-theme="light"]) .btn{color:#08201D}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]) .btn{color:#fff}}
.btn.ghost{background:transparent;color:var(--accent-ink);border-color:var(--rule)}
.btn.ghost:hover{border-color:var(--accent)}
.pagenav{display:flex;justify-content:space-between;gap:12px;margin-top:30px;flex-wrap:wrap}
.pagenav button{font:500 .85rem/1.4 var(--f-body);background:var(--surface);border:1px solid var(--rule);
  border-radius:8px;padding:12px 16px;cursor:pointer;color:var(--ink);text-align:left;max-width:48%}
.pagenav button:hover{border-color:var(--accent)}
.pagenav small{display:block;font-family:var(--f-mono);font-size:.63rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink-faint);margin-bottom:3px}
.wip{border:1px dashed var(--rule);border-radius:10px;padding:18px 20px;background:var(--surface);
  font-size:.93rem;color:var(--ink-soft)}
.wip b{color:var(--ink)}
.pg{display:none}
.pg.on{display:block}
.formula{font-family:var(--f-mono);background:var(--surface);border:1px solid var(--rule);
  border-radius:8px;padding:13px 17px;margin:18px 0;font-size:.92rem;overflow-x:auto;line-height:1.9}
.formula b{color:var(--accent-ink)}
.tl{display:grid;gap:0;margin:22px 0}
.tl>div{display:grid;grid-template-columns:86px 1fr;gap:16px;padding:12px 0;border-top:1px solid var(--rule-soft)}
.tl>div:last-child{border-bottom:1px solid var(--rule-soft)}
.tl em{font-family:var(--f-mono);font-style:normal;font-size:.72rem;color:var(--accent);padding-top:3px}
.tl p{margin:0;font-size:.93rem}
svg text{font-family:var(--f-mono)}

@media(max-width:900px){
  :root{--sidebar:0px}
  .side{position:fixed;left:0;top:0;width:284px;flex-basis:284px;z-index:60;
    transform:translateX(-100%);transition:transform .24s ease}
  .side.open{transform:none}
  .scrim{position:fixed;inset:0;background:rgba(10,14,17,.5);z-index:55;display:none}
  .scrim.on{display:block}
  .burger{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--rule);
    background:var(--surface);border-radius:7px;cursor:pointer;flex:0 0 auto;color:var(--ink);font-size:1rem}
  .wrap{padding:0 20px}
  body{font-size:15.5px}
}
</style>
<div class="shell">
<aside class="side" id="side">
  <div class="brand">
    <b>DSE 經濟科自學課本</b>
    <span>HKDSE Economics · from zero</span>
    <div class="progbar"><i id="pbar"></i></div>
    <div class="progtxt" id="ptxt">已讀 0 / 0 節</div>
  </div>
  <nav id="nav"></nav>
  <div class="sidefoot">
    <button class="mini" id="themebtn">深色</button>
    <button class="mini" id="resetbtn">重設進度</button>
  </div>
</aside>
<div class="scrim" id="scrim"></div>
<main>
  <div class="topbar"><div class="wrap">
    <button class="burger" id="burger" aria-label="開啟目錄">☰</button>
    <div class="crumb" id="crumb">開始</div>
  </div></div>
  <div class="wrap" id="pages">
<section class="pg on" id="pg-home">
  <div class="phead">
    <span class="ltr">從零開始 · 2026</span>
    <h1>整個 DSE 經濟科，只由一句話長出來</h1>
    <p class="en">Everything in HKDSE Economics grows out of one sentence.</p>
    <p class="lede">「想要的無限，資源有限，所以一定要揀；一揀就有代價。」<br>
    Topic A 到 Topic J、十個課題、三年課程，全部都係這句話的延伸。你唔需要背 500 個定義，你需要睇到它們其實係同一件事。</p>
  </div>

  <p>這個網站係跟住<strong>官方課程文件</strong>建的 —— 你 OneDrive 裡那份 <em class="en">Economics Curriculum and Assessment Guide (S4–6) Supplementary Document</em>（CDC-HKEAA，2013）。那份文件逐個 key point 寫明「students are expected to…」同「students are <strong>NOT</strong> expected to…」，即係考試範圍的邊界。所以這裡每一節都會標明：</p>

  <div class="cards">
    <div class="card" style="cursor:default"><em>要求</em><b>考試要你做到什麼</b><span>「理解」同「計算」同「用圖分析」係三種唔同深度的要求，官方文件分得很清楚。</span></div>
    <div class="card" style="cursor:default"><em>不用學</em><b>官方明文唔考的</b><span>例如 Giffen goods、Coase Theorem、Pareto condition、present value 計算 —— 全部唔用學。省你幾十個鐘。</span></div>
    <div class="card" style="cursor:default"><em>生活例子</em><b>用香港嘅事解釋</b><span>茶餐廳、港鐵、公屋輪候、$40 最低工資、聯繫匯率 7.8 —— 概念要摸得到你才記得住。</span></div>
  </div>

